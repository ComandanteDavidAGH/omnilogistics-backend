# --- Obligatorias en producción ---------------------------------------------------------
# Render te entrega esta URL al crear una base PostgreSQL (se acepta el prefijo postgres://)
DATABASE_URL=postgresql://usuario:clave@host:5432/genesis
# Clave SOLO tuya para crear clientes y emitir claves. Genera una larga y aleatoria:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=cambia-esto-por-una-clave-larga
# Dominios del frontend autorizados a llamar la API (separados por coma, SIN comodín *)
ALLOWED_ORIGINS=https://tu-frontend.vercel.app,http://localhost:3000

# --- Opcionales (valores por defecto entre paréntesis) ------------------------------------
# MAX_UPLOAD_MB=20
# MAX_ROWS=200000
# MAX_COLUMNS=200
# RATE_LIMIT_PER_MINUTE=30
# LOG_LEVEL=INFO
